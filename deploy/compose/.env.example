# On-prem settings (Variants B and C). Copy to .env (never commit it). `dpdpctl install` writes this file for you.
# The complete, documented list of application settings is apps/tenant-api/.env.example - this is the subset an on-prem
# install normally sets. Every value is validated at start-up: a wrong or missing one stops the container with a clear list.

# ── What to run ──────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/REPLACE-ORG        # or the local registry / "localhost" after loading a bundle (air-gapped)
APP_VERSION=1.0.0                         # pinned by digest in production: 1.0.0@sha256:...

# ── The portal ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
TENANT_APP_URL=https://compliance.example.internal
TRUST_PROXY=1                             # the reverse proxy in front of the app

# ── Database (bundled PostgreSQL; or override with compose.external-db.yaml) ──
POSTGRES_USER=dpdp
POSTGRES_DB=dpdp_tenant
# The password lives in ./secrets/postgres_password; the app's connection string is assembled from it:
TENANT_DATABASE_URL=postgresql://dpdp:CHANGE-ME@postgres:5432/dpdp_tenant

# ── Queue ────────────────────────────────────────────────────────────────────
VALKEY_PASSWORD=CHANGE-ME
REDIS_URL=redis://:CHANGE-ME@valkey:6379

# ── Security keys (BACK UP SEPARATELY from the database) ─────────────────────
JWT_SECRET=
ENTRA_ENCRYPTION_KEY=
CLOUD_CONNECTION_ENCRYPTION_KEY=

# ── Evidence files ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=/data/evidence
# S3-compatible storage instead: see compose.s3-storage.yaml

# ── Licence ──────────────────────────────────────────────────────────────────
# Give the licence on the first-run page, or here (LICENCE_FILE can point at a mounted secret file):
# LICENCE_TOKEN=
# LICENCE_FILE=/run/secrets/licence

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.example.internal
SMTP_PORT=25
SMTP_USER=                                # empty for an internal relay that needs no login
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.internal

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Local passwords always work (break-glass). OIDC / LDAP settings arrive with step 8.
