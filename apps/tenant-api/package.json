{
  "name": "@dpdp/tenant-api",
  "version": "1.0.0",
  "private": true,
  "description": "Tenant API for DPDP CMS compliance portal",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "build:prod": "esbuild src/app.ts --bundle --platform=node --target=node20 --outfile=dist/app.js --external:@prisma/tenant-client --external:@prisma/client --external:pg && node -e \"require('fs').cpSync('../tenant/dist', 'public', { recursive: true })\"",
    "build:worker:prod": "esbuild src/worker.ts --bundle --platform=node --target=node20 --outfile=dist/worker.js --external:@prisma/tenant-client --external:@prisma/client --external:pg",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "@dpdp/database": "*",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.14",
    "esbuild": "^0.20.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
