# Tenant API + worker settings. Copy to .env (local) or set as environment variables / Key Vault references (deployed).
# Every value is validated at start-up (src/config/validate.ts): a wrong or missing setting stops the process with one
# message listing ALL problems. Never commit a real .env. Secrets may also be supplied through your platform's secret store.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production                  # development | test | production
PORT=3000
# Public address of this portal. Used in email links and as the one browser origin allowed to call the API.
TENANT_APP_URL=https://compliance.example.com
# Extra browser origins allowed to call the API (comma separated, no paths). Normally empty: the portal and API share one address.
# CORS_ALLOWED_ORIGINS=
# Content-Security-Policy for the portal: enforce | report-only | off
# CSP_MODE=enforce
# Reverse-proxy hops in front of the app (so rate limits and audit logs see the real client address). 1 on Azure
# Container Apps / App Service / nginx; false when clients connect directly.
TRUST_PROXY=1
# Seconds a stopping instance waits for running requests before exiting (keep below the platform's kill timeout).
# SHUTDOWN_GRACE_SECONDS=25
# Build identity shown by GET /version (set by the release pipeline).
# APP_VERSION=
# APP_COMMIT=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
TENANT_DATABASE_URL=postgresql://user:password@host:5432/dpdp_tenant?sslmode=require
# Required only until the Super Admin decoupling is finished; removed afterwards.
SUPER_ADMIN_DATABASE_URL=postgresql://user:password@host:5432/dpdp_super_admin?sslmode=require
# Connections per process. Total = replicas x this; keep it below the database server's own limit.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=10000

# ── Queue (Redis / Valkey) ────────────────────────────────────────────────────
# rediss:// = TLS (Azure Managed Redis and most managed services). Percent-encode special characters in the password.
REDIS_URL=rediss://:password@host:10000

# ── Security keys (back these up SEPARATELY from the database: without them stored credentials are unreadable) ──────
# 64 hex characters each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=                          # at least 32 random characters
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
ENTRA_ENCRYPTION_KEY=
CLOUD_CONNECTION_ENCRYPTION_KEY=

# ── Licence (what turns this deployment into your organization's working portal) ─────────────────────────────────
# The vendor issues a signed licence. Give it to the deployment by ONE of:
#   - the first-run page (/activate) and, later, Settings -> Licence;  or
#   - LICENCE_TOKEN (the licence text, e.g. a Container Apps secret) / LICENCE_FILE (a file, e.g. a mounted Docker secret).
# At start-up the instance installs it if it is new or newer than the one in use, so a renewal can also be delivered by
# redeploying the secret. Without a valid licence the portal is read-only ("no licence").
# LICENCE_TOKEN=
# LICENCE_FILE=
# enforce (default in production) | off (development only: licences are not checked; refused in production)
# LICENCE_MODE=enforce
# Extra licence-signing public keys (JSON array of { "kid", "publicKey" }) - development only. In production the
# vendor's key is compiled into the image and these are ignored unless ALLOW_CUSTOM_TRUST_KEYS=true (key rotation).
# PLATFORM_TRUST_KEYS_FILE=
# PLATFORM_TRUST_KEYS=
# ALLOW_CUSTOM_TRUST_KEYS=

# ── Customer evidence storage ─────────────────────────────────────────────────
# local = a folder on this machine / mounted share (UPLOAD_DIR); azure = Azure Blob Storage.
STORAGE_PROVIDER=azure
# UPLOAD_DIR=uploads
AZURE_EVIDENCE_CONNECTION_STRING=
# AZURE_EVIDENCE_CONTAINER=evidence
# MAX_FILE_SIZE_MB=25
# ALLOWED_UPLOAD_EXTENSIONS=          # empty = the built-in allow-list
# FILE_LINK_TTL_SECONDS=60
# /ready reports not-ready when the local upload folder has less free space than this.
# STORAGE_MIN_FREE_MB=256

# ── Email (optional; without it invitations and password resets cannot be emailed) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Leave SMTP_USER / SMTP_PASS empty for an internal relay that needs no login.
SMTP_USER=
SMTP_PASS=
# true = TLS from the first byte (port 465 style). Unset: on for 465, otherwise STARTTLS when offered.
# SMTP_SECURE=
SMTP_FROM_NAME=NiyamSaathi
SMTP_FROM_EMAIL=noreply@example.com

# ── Microsoft Entra sign-in ──────────────────────────────────────────────────
# Defaults to TENANT_APP_URL + /auth/callback; must be registered in the Entra app registration.
# ENTRA_REDIRECT_URI=

# ── Cloud scanning (optional) ────────────────────────────────────────────────
# CLOUD_SCANNER_URL=http://cloud-scanner:8090

# ── Vendor content (LMS media, sample evidence) - interim, replaced by the Asset Library ────────────────────
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_MASTER_EVIDENCE_CONTAINER=master-evidence
# AZURE_STORAGE_LMS_CONTENT_CONTAINER=lms-content
# AZURE_STORAGE_LMS_SUBMISSIONS_CONTAINER=lms-submissions
# AZURE_STORAGE_SAS_EXPIRY_MINUTES=120

# ── Rate limits (per minute / per 15 minutes) ────────────────────────────────
# RATE_LIMIT_USER_PER_MINUTE=600
# RATE_LIMIT_ANON_PER_MINUTE=120
# RATE_LIMIT_AUTH_PER_15MIN=10
# RATE_LIMIT_RESET_REQUEST_PER_15MIN=5
