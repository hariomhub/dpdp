{
  "name": "@dpdp/database",
  "private": true,
  "version": "1.0.0",
  "description": "Shared database schema and Prisma clients for super-admin and tenant portals",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "scripts": {
    "migrate:super-admin": "prisma migrate dev --config=prisma/super-admin/prisma.config.ts",
    "migrate:tenant": "prisma migrate dev --config=prisma/tenant/prisma.config.ts",
    "migrate:super-admin:prod": "prisma migrate deploy --config=prisma/super-admin/prisma.config.ts",
    "migrate:tenant:prod": "prisma migrate deploy --config=prisma/tenant/prisma.config.ts",
    "generate:super-admin": "prisma generate --config=prisma/super-admin/prisma.config.ts",
    "generate:tenant": "prisma generate --config=prisma/tenant/prisma.config.ts",
    "generate": "npm run generate:super-admin && npm run generate:tenant",
    "studio:super-admin": "prisma studio --config=prisma/super-admin/prisma.config.ts",
    "studio:tenant": "prisma studio --config=prisma/tenant/prisma.config.ts",
    "db:reset:super-admin": "prisma migrate reset --config=prisma/super-admin/prisma.config.ts",
    "db:reset:tenant": "prisma migrate reset --config=prisma/tenant/prisma.config.ts",
    "seed:tenant": "ts-node src/seed/tenant-seed.ts"
  }
}
