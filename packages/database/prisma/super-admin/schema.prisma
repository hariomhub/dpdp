generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@prisma/super-admin-client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum OrgStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ControlStatus {
  DRAFT
  PUBLISHED
}

enum ApplicableTo {
  DATA_FIDUCIARY
  SIGNIFICANT_DF
  BOTH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  FILE
  SCREENSHOT
  CONFIG
  DOCUMENT
  LINK
  TEXT_NOTE
  LOG
}

enum LessonType {
  VIDEO
  READING
  ASSIGNMENT
}

enum VideoSource {
  UPLOAD
  EMBED
}

enum ReadingContentType {
  RICH_TEXT
  FILE
}

enum AssignmentSubmissionType {
  TEXT_RESPONSE
  FILE_UPLOAD
  BOTH
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  DESCRIPTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseCategory {
  DPDP_COMPLIANCE
  PORTAL_USAGE
  ROLE_SPECIFIC
  GENERAL
}

enum CertLayout {
  CLASSIC
  MODERN
  MINIMAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RegulationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AuditAction {
  ORG_CREATED
  ORG_UPDATED
  ORG_SUSPENDED
  ORG_ACTIVATED
  ORG_DELETED
  REGULATION_CREATED
  REGULATION_UPDATED
  REGULATION_ARCHIVED
  CONTROL_CREATED
  CONTROL_UPDATED
  CONTROL_PUBLISHED
  CONTROL_DEACTIVATED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_PUBLISHED
  COURSE_ARCHIVED
  QUESTION_CREATED
  QUESTION_UPDATED
  QUESTION_ARCHIVED
  CERT_TEMPLATE_CREATED
  CERT_TEMPLATE_UPDATED
  CERTIFICATE_REVOKED
  LICENSE_CREATED
  LICENSE_RENEWED
  LICENSE_REVOKED
  SUPER_ADMIN_LOGIN
  SUPER_ADMIN_LOGOUT
  SETTINGS_UPDATED
}

// ============================================
// SUPER ADMINS
// ============================================

model SuperAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    PlatformAuditLog[]

  @@map("super_admins")
}

// ============================================
// TENANTS (CLIENT ORGANIZATIONS)
// ============================================

model Tenant {
  id           String    @id @default(uuid())
  tenantCode   String    @unique
  name         String
  industry     String
  orgSize      String
  address      String
  country      String    @default("India")
  website      String?
  contactEmail String
  dpoName      String
  dpoEmail     String
  dpoPhone     String?
  panNumber    String?
  gstNumber    String?
  classification  String  @default("Data Fiduciary")
  classUncertain  Boolean @default(false)
  ceoName      String
  ceoEmail     String
  plan         Plan      @default(STARTER)
  status       OrgStatus @default(ONBOARDING)
  internalNotes String?

  // Deployment fields (Option A — managed deployment)
  tenantPortalUrl    String?   // e.g., https://compliance.technova.in
  deployedAt         DateTime? // when deployment confirmed live
  deploymentNotes    String?   // internal notes about their Azure setup
  currentVersion     String?   // e.g., "1.0.0"

  // Invitation tracking
  inviteToken        String?   @unique
  inviteExpiresAt    DateTime?
  inviteAcceptedAt   DateTime?
  
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  licenseKey   LicenseKey?
  auditLogs    PlatformAuditLog[]

  @@map("tenants")
}

// ============================================
// LICENSE KEYS
// ============================================

model LicenseKey {
  id             String        @id @default(uuid())
  tenantId       String        @unique
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String        @unique @default(uuid())
  plan           Plan
  status         LicenseStatus @default(ACTIVE)
  maxUsers       Int           @default(10)
  maxAssessments Int           @default(5)
  storageGb      Int           @default(10)
  activatedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("license_keys")
}

// ============================================
// REGULATIONS
// ============================================

model Regulation {
  id               String           @id @default(uuid())
  name             String
  shortCode        String           @unique
  issuingAuthority String
  description      String
  jurisdiction     String           @default("India")
  effectiveDate    DateTime
  status           RegulationStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  controlMappings  ControlRegulation[]
  chapters         RegulationChapter[]

  @@map("regulations")
}

model RegulationChapter {
  id           String     @id @default(uuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  name         String     // e.g., "Chapter 2"
  title        String?    // e.g., "Obligations of Data Fiduciary"
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  controlMappings ControlRegulation[]
  sections        RegulationSection[]

  @@unique([regulationId, name])
  @@map("regulation_chapters")
}

// ============================================
// CONTROLS
// ============================================

model Control {
  id               String        @id @default(uuid())
  title            String
  description      String
  applicableTo     ApplicableTo  @default(BOTH)
  status           ControlStatus @default(DRAFT)
  isCustom         Boolean       @default(false)
  tenantId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  regulationMappings  ControlRegulation[]
  predefinedActions   ControlPredefinedAction[]
  families            ControlFamilyMember[]

  @@map("controls")
}

model ControlRegulation {
  controlId        String
  regulationId     String
  chapterId        String?
  sectionId        String?
  control          Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  regulation       Regulation          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  chapter          RegulationChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  section          RegulationSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@id([controlId, regulationId])
  @@map("control_regulations")
}

model ControlPredefinedAction {
  id               String       @id @default(uuid())
  controlId        String
  control          Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  title            String
  description      String
  evidenceTypes    EvidenceType[]
  suggestedDueDays Int          @default(30)
  priority         Priority     @default(HIGH)
  orderIndex       Int          @default(0)
  products         ActionProduct[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("control_predefined_actions")
}

// ============================================
// CERTIFICATE TEMPLATES
// ============================================

model CertificateTemplate {
  id           String     @id @default(uuid())
  name         String
  layout       CertLayout @default(CLASSIC)
  titleText    String     @default("Certificate of Completion")
  bodyText     String
  signatory    String?
  designation  String?
  signatureUrl String?
  logoUrl      String?
  bgColor      String     @default("#FFFFFF")
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  courses      LmsCourse[]

  @@map("certificate_templates")
}

// ============================================
// LMS COURSES
// ============================================

model LmsCourse {
  id                    String               @id @default(uuid())
  title                 String
  description           String
  category              CourseCategory
  difficulty            CourseDifficulty
  estimatedHours        Int                  @default(0)
  estimatedMinutes      Int                  @default(0)
  thumbnailUrl          String?
  status                CourseStatus         @default(DRAFT)
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  sections              LmsSection[]
  designations          LmsCourseDesignation[]

  @@map("lms_courses")
}

// ============================================
// LMS SECTIONS
// ============================================

model LmsSection {
  id          String     @id @default(uuid())
  courseId    String
  course      LmsCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lessons     LmsLesson[]
  quiz        LmsQuiz?

  @@map("lms_sections")
}

// ============================================
// LMS LESSONS
// ============================================

model LmsLesson {
  id                       String                    @id @default(uuid())
  sectionId                String
  section                  LmsSection                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title                    String
  description              String?
  type                     LessonType
  orderIndex               Int                       @default(0)
  videoSource              VideoSource?
  videoUrl                 String?
  videoDurationS           Int?
  readingContentType       ReadingContentType?
  readingContent           String?
  assignmentInstructions   String?
  assignmentSubmissionType AssignmentSubmissionType?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@map("lms_lessons")
}

// ============================================
// LMS QUIZ
// ============================================

model LmsQuiz {
  id            String     @id @default(uuid())
  sectionId     String     @unique
  section       LmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title         String
  passThreshold Int        @default(70)
  timeLimitMins Int?
  totalMarks    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  questions     QuizQuestion[]

  @@map("lms_quizzes")
}

// ============================================
// QUESTION BANK
// ============================================

model QuizQuestion {
  id              String       @id @default(uuid())
  quizId          String?
  quiz            LmsQuiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  questionText    String
  type            QuestionType
  marks           Int          @default(1)
  difficulty      Difficulty   @default(MEDIUM)
  topic           String?
  orderIndex      Int          @default(0)
  tfCorrectAnswer Boolean?
  modelAnswer     String?
  wordLimit       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  options         QuestionOption[]

  @@map("quiz_questions")
}

model QuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)

  @@map("question_options")
}

// ============================================
// PLATFORM AUDIT LOG
// ============================================

model PlatformAuditLog {
  id           String      @id @default(uuid())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action       AuditAction
  targetType   String
  targetId     String?
  targetName   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@map("platform_audit_logs")
}
// ============================================
// CONTROL FAMILIES
// Cross-cutting grouping of controls,
// independent of regulation chapters.
// One control can belong to multiple families.
// ============================================

model ControlFamily {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  icon        String?   // emoji or icon identifier for UI display
  color       String?   // hex color e.g. "#3B82F6"
  status      String    @default("ACTIVE")
  controls    ControlFamilyMember[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("control_families")
}

model ControlFamilyMember {
  controlFamilyId String
  controlId       String
  controlFamily   ControlFamily @relation(fields: [controlFamilyId], references: [id], onDelete: Cascade)
  control         Control       @relation(fields: [controlId], references: [id], onDelete: Cascade)
  addedAt         DateTime      @default(now())

  @@id([controlFamilyId, controlId])
  @@map("control_family_members")
}

// ============================================
// PRODUCT FAMILIES + PRODUCTS
// Tools/software that implement control actions.
// ProductFamily groups related products.
// A product belongs to one family OR is standalone.
// ============================================

model ProductFamily {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  category    String?   // e.g. "IAM", "Data Protection", "Monitoring", "SIEM"
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_families")
}

model Product {
  id              String         @id @default(uuid())
  name            String
  description     String?
  vendor          String?        // company name e.g. "Microsoft", "AWS"
  website         String?
  logoUrl         String?
  category        String?
  productFamilyId String?        // null = standalone product not in any family
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: SetNull)
  actions         ActionProduct[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("products")
}

// Junction: ControlPredefinedAction <-> Product
// An action can be implemented by multiple products.
model ActionProduct {
  predefinedActionId String
  productId          String
  predefinedAction   ControlPredefinedAction @relation(fields: [predefinedActionId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt            DateTime                @default(now())
  masterEvidences    MasterEvidence[]

  @@id([predefinedActionId, productId])
  @@map("action_products")
}


// ============================================
// REGULATION SECTIONS
// Sub-divisions of regulation chapters.
// Chapter required, section optional on control mapping.
// ============================================

model RegulationSection {
  id        String            @id @default(uuid())
  chapterId String
  chapter   RegulationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name      String            // e.g., "Section 6"
  title     String?           // e.g., "Consent"
  orderIndex Int              @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  controlMappings ControlRegulation[]

  @@unique([chapterId, name])
  @@map("regulation_sections")
}

// ============================================
// MASTER EVIDENCE
// Template/expected evidence per action-product pair.
// Storage: local disk now, Azure Blob when configured.
// To migrate to Azure: set STORAGE_PROVIDER=azure + Azure env vars.
// No code changes needed beyond config.
// ============================================

model MasterEvidence {
  id              String       @id @default(uuid())
  predefinedActionId String
  productId          String
  title           String       // "Sample Azure AD MFA Configuration"
  description     String?      // "Screenshot showing MFA policy with all users enforced"
  fileName        String?
  fileSize        Int?
  mimeType        String?
  fileUrl         String?      // local path or blob URL
  storageProvider String       @default("local")
  uploadedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  actionProduct   ActionProduct @relation(fields: [predefinedActionId, productId], references: [predefinedActionId, productId], onDelete: Cascade)

  @@map("master_evidences")
}


// ============================================
// LMS DESIGNATIONS
// Business roles / designations (CISO, DPO, etc.)
// Super admin manages catalog, courses are tagged to designations.
// Tenants assign designations to users (stored as string reference).
// ============================================

model LmsDesignation {
  id           String   @id @default(uuid())
  name         String   @unique  // "CISO", "DPO", "CTO" etc.
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses      LmsCourseDesignation[]

  @@map("lms_designations")
}

model LmsCourseDesignation {
  courseId      String
  designationId String
  isMandatory   Boolean  @default(true)  // true = auto-enroll, false = optional/recommended
  addedAt       DateTime @default(now())

  course        LmsCourse      @relation(fields: [courseId],      references: [id], onDelete: Cascade)
  designation   LmsDesignation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@id([courseId, designationId])
  @@map("lms_course_designations")
}
