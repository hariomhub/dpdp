generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@prisma/super-admin-client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum OrgStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ControlStatus {
  DRAFT
  PUBLISHED
}

enum ApplicableTo {
  DATA_FIDUCIARY
  SIGNIFICANT_DF
  BOTH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  FILE
  SCREENSHOT
  CONFIG
  DOCUMENT
  LINK
  TEXT_NOTE
  LOG
}

enum LessonType {
  VIDEO
  READING
  ASSIGNMENT
}

enum VideoSource {
  UPLOAD
  EMBED
}

enum ReadingContentType {
  RICH_TEXT
  FILE
}

enum AssignmentSubmissionType {
  TEXT_RESPONSE
  FILE_UPLOAD
  BOTH
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  DESCRIPTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseCategory {
  DPDP_COMPLIANCE
  PORTAL_USAGE
  ROLE_SPECIFIC
  GENERAL
}

enum CertLayout {
  CLASSIC
  MODERN
  MINIMAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RegulationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Regulatory-text-level fact for NodeApplicability: does this node
// (clause/standard) apply to a given category, and if so is it
// mandatory or exempted there. Reproduces SEBI CSCRF's exemption
// tables exactly (e.g. "Standard X is exempted for Self-cert REs").
enum NodeApplicabilityStatus {
  MANDATORY
  APPLICABLE
  EXEMPT
}

// Which entity a CustomFieldDefinition's values attach to.
enum CustomFieldScope {
  CONTROL
  ACTION
}

// Fixed, small, universal set of input-widget types — unlike
// nodeType/applicability-category code, this never varies per
// regulation, so it stays a real enum rather than free text.
enum CustomFieldDataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
  MULTI_SELECT
}

enum ProviderCategory {
  CLOUD_INFRASTRUCTURE
  IDENTITY_SAAS
  DEVOPS_SOURCE
  DATABASE_SERVICE
  EDGE_PLATFORM
  CONTAINER_ORCHESTRATION
  EMERGING
}

enum AuditAction {
  ORG_CREATED
  LICENCE_ISSUED
  ORG_UPDATED
  ORG_SUSPENDED
  ORG_ACTIVATED
  ORG_DELETED
  REGULATION_CREATED
  REGULATION_UPDATED
  REGULATION_ARCHIVED
  REGULATION_DELETED
  CONTROL_CREATED
  CONTROL_UPDATED
  CONTROL_PUBLISHED
  CONTROL_DEACTIVATED
  MASTER_CONTROL_CREATED
  MASTER_CONTROL_UPDATED
  MASTER_CONTROL_DELETED
  MASTER_CONTROL_ACTION_CREATED
  MASTER_CONTROL_ACTION_UPDATED
  MASTER_CONTROL_ACTION_DELETED
  CONTROL_LINKED_TO_MASTER
  CONTROL_UNLINKED_FROM_MASTER
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_PUBLISHED
  COURSE_ARCHIVED
  QUESTION_CREATED
  QUESTION_UPDATED
  QUESTION_ARCHIVED
  CERT_TEMPLATE_CREATED
  CERT_TEMPLATE_UPDATED
  CERTIFICATE_REVOKED
  LICENSE_CREATED
  LICENSE_RENEWED
  LICENSE_REVOKED
  SUPER_ADMIN_LOGIN
  SUPER_ADMIN_LOGOUT
  SETTINGS_UPDATED
  CLOUD_PROVIDER_CREATED
  CLOUD_PROVIDER_UPDATED
  CLOUD_PROVIDER_TOGGLED
  ASSET_TEMPLATE_CREATED
  ASSET_TEMPLATE_UPDATED
  ASSET_TEMPLATE_DELETED
  CHECK_MAPPING_CREATED
  CHECK_MAPPING_UPDATED
  CHECK_MAPPING_DELETED
}

// ============================================
// SUPER ADMINS
// ============================================

model SuperAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    PlatformAuditLog[]

  @@map("super_admins")
}

// ============================================
// TENANTS (CLIENT ORGANIZATIONS)
// ============================================

model Tenant {
  id           String    @id @default(uuid())
  tenantCode   String    @unique
  name         String
  industry     String
  orgSize      String
  address      String
  country      String    @default("India")
  website      String?
  contactEmail String
  dpoName      String
  dpoEmail     String
  dpoPhone     String?
  panNumber    String?
  gstNumber    String?
  classification  String  @default("Data Fiduciary")
  classUncertain  Boolean @default(false)
  ceoName      String
  ceoEmail     String
  plan         Plan      @default(STARTER)
  status       OrgStatus @default(ONBOARDING)
  internalNotes String?

  // Deployment fields (Option A — managed deployment)
  tenantPortalUrl    String?   // e.g., https://compliance.technova.in
  deployedAt         DateTime? // when deployment confirmed live
  deploymentNotes    String?   // internal notes about their Azure setup
  currentVersion     String?   // e.g., "1.0.0"

  // Invitation tracking
  inviteToken        String?   @unique
  inviteExpiresAt    DateTime?
  inviteAcceptedAt   DateTime?
  
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  licenseKey   LicenseKey?
  auditLogs    PlatformAuditLog[]

  // Per-regulation classification — a tenant can hold a different
  // applicability category under every regulation simultaneously
  // (e.g. Significant DF under DPDP, Qualified RE under SEBI CSCRF).
  // Supersedes the classification/classUncertain fields above for any
  // regulation that has been migrated onto RegulationApplicabilityCategory;
  // those fields stay in place (deprecated) until DPDP is backfilled.
  regulationClassifications TenantRegulationClassification[]

  @@map("tenants")
}

// ============================================
// LICENSE KEYS
// ============================================

model LicenseKey {
  id             String        @id @default(uuid())
  tenantId       String        @unique
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String        @unique @default(uuid())
  plan           Plan
  status         LicenseStatus @default(ACTIVE)
  maxUsers       Int           @default(10)
  maxAssessments Int           @default(5)
  storageGb      Int           @default(10)
  activatedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("license_keys")
}

// ============================================
// REGULATIONS
// ============================================

model Regulation {
  id               String           @id @default(uuid())
  name             String
  shortCode        String           @unique
  issuingAuthority String
  description      String
  jurisdiction     String           @default("India")
  effectiveDate    DateTime
  status           RegulationStatus @default(DRAFT)
  documentType     String?          // free text: "Act", "Circular", "Master Circular", "Framework", ...
  version          String?          // e.g. "1.0" — regulations get amended/reissued over time
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Deprecated — superseded by nodes/controls below. Kept until the
  // cutover to RegulationNode/Control.regulationId is verified, then
  // dropped in a later cleanup migration.
  controlMappings  ControlRegulation[]
  chapters         RegulationChapter[]

  nodes                    RegulationNode[]
  applicabilityCategories  RegulationApplicabilityCategory[]
  customFieldDefinitions   CustomFieldDefinition[]
  controls                 Control[]
  predefinedActions        ControlPredefinedAction[]
  tenantClassifications    TenantRegulationClassification[]

  @@map("regulations")
}

// Deprecated — superseded by RegulationNode. Left in place (and still
// fully populated/functional) until the cutover is verified; removed
// in a later cleanup migration, not this one.
model RegulationChapter {
  id           String     @id @default(uuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  name         String     // e.g., "Chapter 2"
  title        String?    // e.g., "Obligations of Data Fiduciary"
  orderIndex   Int        @default(0)
  isMandatory  Boolean    @default(false) // controls under this chapter cannot be excluded from an assessment
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  controlMappings ControlRegulation[]
  sections        RegulationSection[]

  @@unique([regulationId, name])
  @@map("regulation_chapters")
}

// ============================================
// REGULATION STRUCTURE (generic — every regulation)
// Self-referencing tree, replaces RegulationChapter +
// RegulationSection. nodeType/code are free text so each
// regulation keeps its own vocabulary and depth: "Chapter"/
// "Section" for DPDP, "Part"/"Function"/"Domain"/"Standard"
// for SEBI CSCRF, "Annexure" as a root-level sibling of Parts.
// ============================================

model RegulationNode {
  id           String           @id @default(uuid())
  regulationId String
  regulation   Regulation       @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       RegulationNode?  @relation("RegulationNodeParent", fields: [parentId], references: [id], onDelete: Cascade)
  children     RegulationNode[] @relation("RegulationNodeParent")

  nodeType   String   // free text: "Chapter", "Part", "Function", "Domain", "Standard", "Annexure", ...
  code       String   // the regulation's own citation string, e.g. "II", "8", "GV.RR.S3", "Annexure-K"
  title      String?
  content    String?  // optional longer prescriptive text (e.g. a SEBI standard's full wording)
  orderIndex Int      @default(0)
  depth      Int      @default(0)
  path       String   @default("") // materialized path of node ids for fast ancestor/descendant queries
  metadata   Json?    // escape hatch for regulation-specific structured extras
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  controlLinks    ControlNode[]
  applicabilities NodeApplicability[]

  @@index([regulationId, parentId])
  @@map("regulation_nodes")
}

// A regulation's own classification scheme — DPDP: Data Fiduciary /
// Significant DF. SEBI CSCRF: MII / Qualified RE / Mid-size RE /
// Small-size RE / Self-cert RE. Each regulation defines its own rows;
// no platform-wide enum to extend every time a new regulation arrives.
model RegulationApplicabilityCategory {
  id              String     @id @default(uuid())
  regulationId    String
  regulation      Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  code            String     // e.g. "SIGNIFICANT_DF", "QUALIFIED_RE", "MII"
  label           String     // e.g. "Significant Data Fiduciary", "Qualified RE"
  criteriaSummary String?    // e.g. "AUM >= Rs. 1000 crore" — descriptive, not a rules engine
  orderIndex      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  nodeApplicabilities    NodeApplicability[]
  controlApplicabilities ControlApplicability[]
  tenantClassifications  TenantRegulationClassification[]

  @@unique([regulationId, code])
  @@map("regulation_applicability_categories")
}

// Regulatory-text-level fact: does this node (clause/standard) apply
// to this category, and is it mandatory or exempted there. This is
// what "mandatory chapter" logic reads going forward (any depth, not
// just the old chapter-only isMandatory flag), and what reproduces
// SEBI's exemption tables (Tables 25/26) exactly.
model NodeApplicability {
  id                      String                          @id @default(uuid())
  nodeId                  String
  node                    RegulationNode                  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  applicabilityCategoryId String
  applicabilityCategory   RegulationApplicabilityCategory @relation(fields: [applicabilityCategoryId], references: [id], onDelete: Cascade)
  status                  NodeApplicabilityStatus         @default(APPLICABLE)
  note                    String?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@unique([nodeId, applicabilityCategoryId])
  @@map("node_applicabilities")
}

// Admin-defined, no-deploy custom fields per regulation (e.g. SEBI's
// "CCI Weightage", "Periodicity"). Field shape is data, not a Prisma
// model — values are stored in Control.customFields / ControlPredefinedAction.customFields,
// keyed by `key`. See CustomFieldDataType for why dataType stays an enum
// while nodeType/category code stay free text.
model CustomFieldDefinition {
  id           String              @id @default(uuid())
  regulationId String
  regulation   Regulation          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  scope        CustomFieldScope
  key          String              // machine name, e.g. "cciWeightage"
  label        String              // display name, e.g. "CCI Weightage"
  dataType     CustomFieldDataType
  options      Json?               // [{ value, label }] for SINGLE_SELECT / MULTI_SELECT
  isRequired   Boolean             @default(false)
  helpText     String?
  orderIndex   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([regulationId, scope, key])
  @@map("custom_field_definitions")
}

// A tenant's classification under one specific regulation — a tenant
// can be Significant DF under DPDP and Qualified RE under SEBI CSCRF
// at the same time. Lives here (super-admin DB), next to Tenant, not
// in the tenant DB, since Tenant.classification already lives here.
model TenantRegulationClassification {
  id                      String                          @id @default(uuid())
  tenantId                String
  tenant                  Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regulationId            String
  regulation              Regulation                      @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  applicabilityCategoryId String
  applicabilityCategory   RegulationApplicabilityCategory @relation(fields: [applicabilityCategoryId], references: [id], onDelete: Restrict)
  isUncertain             Boolean                         @default(false)
  classifiedAt            DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@unique([tenantId, regulationId])
  @@map("tenant_regulation_classifications")
}

// ============================================
// MASTER CONTROLS
// Cross-regulation equivalence, distinct from ControlFamily (a loose,
// many-to-many browsing tag). A MasterControl asserts a much stronger
// claim: these regulation-specific controls represent the SAME
// underlying obligation, such that completing one genuinely satisfies
// the others (e.g. "MFA for privileged access" cited by both DPDP and
// SEBI CSCRF). Deliberately admin-curated only — no auto-matching —
// since a false equivalence here is a real compliance risk, not just a
// UI inconvenience. Optional on Control: most controls have no
// cross-regulation equivalent and should stay standalone.
// ============================================

model MasterControl {
  id          String   @id @default(uuid())
  // Human-readable, sequential, admin-facing identifier — MC-001, MC-002, …
  // "MC" for Master Control, matching the entity's name everywhere else in
  // the product rather than introducing a second term for the same thing.
  code        String   @unique
  title       String
  description String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions  MasterControlAction[]
  controls Control[]

  @@map("master_controls")
}

// The canonical, regulation-agnostic action list — authored once here
// instead of duplicated per regulation. A regulation-specific
// ControlPredefinedAction optionally links back via masterActionId to
// say "this action IS the master's action for this regulation"; a
// regulation-specific control can still carry its OWN additional
// actions on top when its requirement is stricter or genuinely
// different (additive, never a replacement of the master action).
model MasterControlAction {
  id               String         @id @default(uuid())
  masterControlId  String
  masterControl    MasterControl  @relation(fields: [masterControlId], references: [id], onDelete: Cascade)
  title            String
  description      String
  evidenceTypes    EvidenceType[]
  suggestedDueDays Int            @default(30)
  priority         Priority       @default(HIGH)
  orderIndex       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  linkedActions ControlPredefinedAction[]

  @@map("master_control_actions")
}

// ============================================
// CONTROLS
// ============================================

model Control {
  id               String        @id @default(uuid())
  title            String
  description      String
  // Deprecated — superseded by ControlApplicability, which reuses the
  // same regulation-defined category vocabulary instead of this
  // platform-wide, DPDP-shaped enum. Kept until backfilled/verified.
  applicableTo     ApplicableTo  @default(BOTH)
  status           ControlStatus @default(DRAFT)
  isCustom         Boolean       @default(false)
  tenantId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Cross-regulation equivalence — see MasterControl above. Nullable:
  // most controls stand alone.
  masterControlId String?
  masterControl   MasterControl? @relation(fields: [masterControlId], references: [id], onDelete: SetNull)

  // "Home" regulation — which regulation this control was authored
  // under. Nullable: a tenant's purely internal custom control can
  // have no regulation at all. Denormalizes onto ControlPredefinedAction
  // for fast filtering. Distinct from `nodes` below, which is the full,
  // unrestricted set of citations this control satisfies (can span
  // other regulations too — see ControlNode).
  regulationId String?
  regulation   Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)

  // Denormalized union of every regulation this control touches
  // (its home regulationId plus every regulation reachable through
  // `nodes`), maintained by the service layer wherever ControlNode
  // rows change. GIN-indexed for fast "show me everything touching
  // regulation X" filtering without a join.
  citedRegulationIds String[] @default([])

  // Regulation-specific structured data (e.g. SEBI's CCI weightage),
  // keyed by CustomFieldDefinition.key. No schema change needed to
  // add a new field — see CustomFieldDefinition.
  customFields Json?

  // Deprecated — superseded by `nodes` (ControlNode) + `regulationId`
  // above. Kept until backfilled/verified, then dropped.
  regulationMappings  ControlRegulation[]
  predefinedActions   ControlPredefinedAction[]
  families            ControlFamilyMember[]

  nodes          ControlNode[]
  applicabilities ControlApplicability[]

  @@map("controls")
}

// Deprecated — superseded by ControlNode + Control.regulationId.
// Left in place (and still fully populated/functional) until the
// cutover is verified; removed in a later cleanup migration.
model ControlRegulation {
  controlId        String
  regulationId     String
  chapterId        String?
  sectionId        String?
  control          Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  regulation       Regulation          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  chapter          RegulationChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  section          RegulationSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@id([controlId, regulationId])
  @@map("control_regulations")
}

// Every citation this control satisfies — deliberately NOT restricted
// to the control's own `regulationId`. Real data already needs this:
// a control can be cited against nodes in more than one regulation
// (e.g. one MFA control satisfying both an RBI clause and a SEBI
// standard). isPrimary distinguishes the control's home citation(s)
// from bonus/reused ones for reporting purposes.
model ControlNode {
  id        String         @id @default(uuid())
  controlId String
  control   Control        @relation(fields: [controlId], references: [id], onDelete: Cascade)
  nodeId    String
  node      RegulationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  isPrimary Boolean        @default(true)
  note      String?
  createdAt DateTime       @default(now())

  @@unique([controlId, nodeId])
  @@map("control_nodes")
}

// Catalog-curation-level fact: which applicability category(ies) this
// specific control implementation is scoped to — today's
// Control.applicableTo, preserved as its own concept because it's
// independent of NodeApplicability (a regulatory clause's own
// mandatory/exempt status). Absence of any row = applies broadly,
// matching today's "BOTH" semantics.
model ControlApplicability {
  controlId               String
  control                 Control                         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  applicabilityCategoryId String
  applicabilityCategory   RegulationApplicabilityCategory @relation(fields: [applicabilityCategoryId], references: [id], onDelete: Cascade)
  addedAt                 DateTime                        @default(now())

  @@id([controlId, applicabilityCategoryId])
  @@map("control_applicabilities")
}

model ControlPredefinedAction {
  id               String       @id @default(uuid())
  controlId        String
  control          Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  title            String
  description      String
  evidenceTypes    EvidenceType[]
  suggestedDueDays Int          @default(30)
  priority         Priority     @default(HIGH)
  orderIndex       Int          @default(0)
  products         ActionProduct[]
  checkMappings    ControlCheckMapping[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Denormalized copy of the parent Control's regulationId, set at
  // creation time, for fast "all SEBI actions" style filtering
  // without a join back through Control.
  regulationId String?
  regulation   Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)

  // Regulation-specific structured data at the action level (e.g.
  // SEBI's periodicity — how often this action recurs, arguably an
  // action-level fact rather than a control-level one). Keyed by
  // CustomFieldDefinition.key, scope=ACTION.
  customFields Json?

  // Which MasterControlAction this regulation-specific action
  // implements, if any — see MasterControl above. Nullable: most
  // actions have no cross-regulation equivalent.
  masterActionId String?
  masterAction   MasterControlAction? @relation(fields: [masterActionId], references: [id], onDelete: SetNull)

  @@map("control_predefined_actions")
}

// ============================================
// CERTIFICATE TEMPLATES
// ============================================

model CertificateTemplate {
  id           String     @id @default(uuid())
  name         String
  layout       CertLayout @default(CLASSIC)
  titleText    String     @default("Certificate of Completion")
  bodyText     String
  signatory    String?
  designation  String?
  signatureUrl String?
  logoUrl      String?
  bgColor      String     @default("#FFFFFF")
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  courses      LmsCourse[]

  @@map("certificate_templates")
}

// ============================================
// LMS COURSES
// ============================================

model LmsCourse {
  id                    String               @id @default(uuid())
  title                 String
  description           String
  category              CourseCategory
  difficulty            CourseDifficulty
  estimatedHours        Int                  @default(0)
  estimatedMinutes      Int                  @default(0)
  thumbnailUrl          String?
  status                CourseStatus         @default(DRAFT)
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  sections              LmsSection[]
  designations          LmsCourseDesignation[]
  portalRoles           LmsCoursePortalRole[]

  @@map("lms_courses")
}

// ============================================
// LMS SECTIONS
// ============================================

model LmsSection {
  id          String     @id @default(uuid())
  courseId    String
  course      LmsCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lessons     LmsLesson[]
  quiz        LmsQuiz?

  @@map("lms_sections")
}

// ============================================
// LMS LESSONS
// ============================================

model LmsLesson {
  id                       String                    @id @default(uuid())
  sectionId                String
  section                  LmsSection                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title                    String
  description              String?
  type                     LessonType
  orderIndex               Int                       @default(0)
  videoSource              VideoSource?
  videoUrl                 String?
  videoDurationS           Int?
  readingContentType       ReadingContentType?
  readingContent           String?
  assignmentInstructions   String?
  assignmentSubmissionType AssignmentSubmissionType?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@map("lms_lessons")
}

// ============================================
// LMS QUIZ
// ============================================

model LmsQuiz {
  id            String     @id @default(uuid())
  sectionId     String     @unique
  section       LmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title         String
  passThreshold Int        @default(70)
  timeLimitMins Int?
  totalMarks    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  questions     QuizQuestion[]

  @@map("lms_quizzes")
}

// ============================================
// QUESTION BANK
// ============================================

model QuizQuestion {
  id              String       @id @default(uuid())
  quizId          String?
  quiz            LmsQuiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  questionText    String
  type            QuestionType
  marks           Int          @default(1)
  difficulty      Difficulty   @default(MEDIUM)
  topic           String?
  orderIndex      Int          @default(0)
  tfCorrectAnswer Boolean?
  modelAnswer     String?
  wordLimit       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  options         QuestionOption[]

  @@map("quiz_questions")
}

model QuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)

  @@map("question_options")
}

// ============================================
// PLATFORM AUDIT LOG
// ============================================

model PlatformAuditLog {
  id           String      @id @default(uuid())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action       AuditAction
  targetType   String
  targetId     String?
  targetName   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@map("platform_audit_logs")
}
// ============================================
// CONTROL FAMILIES
// Cross-cutting grouping of controls,
// independent of regulation chapters.
// One control can belong to multiple families.
// ============================================

model ControlFamily {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  icon        String?   // emoji or icon identifier for UI display
  color       String?   // hex color e.g. "#3B82F6"
  status      String    @default("ACTIVE")
  controls    ControlFamilyMember[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("control_families")
}

model ControlFamilyMember {
  controlFamilyId String
  controlId       String
  controlFamily   ControlFamily @relation(fields: [controlFamilyId], references: [id], onDelete: Cascade)
  control         Control       @relation(fields: [controlId], references: [id], onDelete: Cascade)
  addedAt         DateTime      @default(now())

  @@id([controlFamilyId, controlId])
  @@map("control_family_members")
}

// ============================================
// PRODUCT FAMILIES + PRODUCTS
// Tools/software that implement control actions.
// ProductFamily groups related products.
// A product belongs to one family OR is standalone.
// ============================================

model ProductFamily {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  category    String?   // e.g. "IAM", "Data Protection", "Monitoring", "SIEM"
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_families")
}

model Product {
  id              String         @id @default(uuid())
  name            String
  description     String?
  vendor          String?        // company name e.g. "Microsoft", "AWS"
  website         String?
  logoUrl         String?
  category        String?
  productFamilyId String?        // null = standalone product not in any family
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: SetNull)
  actions         ActionProduct[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("products")
}

// Junction: ControlPredefinedAction <-> Product
// An action can be implemented by multiple products.
model ActionProduct {
  predefinedActionId String
  productId          String
  predefinedAction   ControlPredefinedAction @relation(fields: [predefinedActionId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt            DateTime                @default(now())
  masterEvidences    MasterEvidence[]

  @@id([predefinedActionId, productId])
  @@map("action_products")
}


// ============================================
// REGULATION SECTIONS
// Sub-divisions of regulation chapters.
// Chapter required, section optional on control mapping.
// ============================================

model RegulationSection {
  id        String            @id @default(uuid())
  chapterId String
  chapter   RegulationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name      String            // e.g., "Section 6"
  title     String?           // e.g., "Consent"
  orderIndex Int              @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  controlMappings ControlRegulation[]

  @@unique([chapterId, name])
  @@map("regulation_sections")
}

// ============================================
// MASTER EVIDENCE
// Template/expected evidence per action-product pair.
// Storage: local disk now, Azure Blob when configured.
// To migrate to Azure: set STORAGE_PROVIDER=azure + Azure env vars.
// No code changes needed beyond config.
// ============================================

model MasterEvidence {
  id              String       @id @default(uuid())
  predefinedActionId String
  productId          String
  title           String       // "Sample Azure AD MFA Configuration"
  description     String?      // "Screenshot showing MFA policy with all users enforced"
  fileName        String?
  fileSize        Int?
  mimeType        String?
  fileUrl         String?      // local path or blob URL
  storageProvider String       @default("local")
  uploadedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  actionProduct   ActionProduct @relation(fields: [predefinedActionId, productId], references: [predefinedActionId, productId], onDelete: Cascade)

  @@map("master_evidences")
}


// ============================================
// LMS DESIGNATIONS
// Business roles / designations (CISO, DPO, etc.)
// Super admin manages catalog, courses are tagged to designations.
// Tenants assign designations to users (stored as string reference).
// ============================================

model LmsDesignation {
  id           String   @id @default(uuid())
  name         String   @unique  // "CISO", "DPO", "CTO" etc.
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses      LmsCourseDesignation[]

  @@map("lms_designations")
}

model LmsCourseDesignation {
  courseId      String
  designationId String
  isMandatory   Boolean  @default(true)  // true = auto-enroll, false = optional/recommended
  addedAt       DateTime @default(now())

  course        LmsCourse      @relation(fields: [courseId],      references: [id], onDelete: Cascade)
  designation   LmsDesignation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@id([courseId, designationId])
  @@map("lms_course_designations")
}

// Targets a course at the platform's OWN permission role (CEO/CO/IT_ADMIN/
// INTERNAL_AUDITOR/EXTERNAL_AUDITOR) rather than a real-world job-function
// designation — for "how do I use this portal" content, where relevance is
// determined by what the software lets that role do, not by the learner's
// actual job title. Independent axis from LmsCourseDesignation; a course can
// use either, both, or neither.
model LmsCoursePortalRole {
  courseId    String
  portalRole  String   // soft-reference to the tenant schema's TenantRole enum
                        // by value — same cross-schema pattern already used by
                        // RoleDesignationDefault.designation (tenant schema)
                        // referencing LmsDesignation.name (this schema).
  isMandatory Boolean  @default(true)
  addedAt     DateTime @default(now())

  course      LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, portalRole])
  @@map("lms_course_portal_roles")
}

// ============================================
// CONTROL <-> CHECK MAPPING
// Maps a DPDP ControlPredefinedAction to a specific Prowler check on a
// specific provider — "when this check passes on a resource, that's
// evidence this action is satisfied." Same curated-catalog pattern as
// GenericAssetTemplate: starts empty/sparse, grows as Super Admin maps
// real checks, checkTitle/checkSeverity cached at mapping time so the
// catalog UI doesn't need a live cloud-scanner call to render a list.
// ============================================

model ControlCheckMapping {
  id                 String                  @id @default(uuid())
  predefinedActionId String
  predefinedAction   ControlPredefinedAction @relation(fields: [predefinedActionId], references: [id], onDelete: Cascade)
  providerId         String
  provider           CloudProviderType       @relation(fields: [providerId], references: [id], onDelete: Cascade)

  checkId            String                  // Prowler's CheckID, e.g. "s3_bucket_level_public_access_block"
  checkTitle         String                  // cached from Prowler's check metadata at mapping time
  checkSeverity      String?                 // cached severity (low/medium/high/critical)

  status             ControlStatus           @default(DRAFT)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([predefinedActionId, providerId, checkId])
  @@map("control_check_mappings")
}

// ============================================
// CLOUD PROVIDER REGISTRY
// Master catalog of cloud/SaaS providers Prowler can
// scan. Super Admin controls which are active and
// therefore selectable by tenants at connection time.
// ============================================

model CloudProviderType {
  id               String           @id @default(uuid())
  key              String           @unique  // matches Prowler's provider key exactly, e.g. "azure"
  displayName      String                    // "Microsoft Azure"
  category         ProviderCategory
  isActive         Boolean          @default(false)
  credentialSchema Json                      // field shape required to connect (mirrors Prowler's own credential schema)
  logoUrl          String?
  docsUrl          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assetTemplates   GenericAssetTemplate[]
  checkMappings    ControlCheckMapping[]

  @@map("cloud_provider_types")
}

// ============================================
// GENERIC ASSET CATALOG
// Maps a provider's native resource type (Prowler's
// ResourceType, e.g. "microsoft.storage/storageaccounts")
// to a tenant AssetType value. assetType is stored as a
// plain string, not a Prisma enum reference — it
// corresponds to the AssetType enum in the TENANT schema,
// which lives in a separate database and cannot be
// referenced directly. Validated at the application layer
// against the known AssetType set.
// ============================================

model GenericAssetTemplate {
  id                      String            @id @default(uuid())
  providerId              String
  provider                CloudProviderType @relation(fields: [providerId], references: [id], onDelete: Cascade)
  cloudResourceType       String            // Prowler's ResourceType string for this provider
  displayName             String            // "Azure Storage Account"
  assetType               String            // must match a tenant-schema AssetType enum value
  defaultCriticality      String            @default("MEDIUM")
  suggestedDataCategories String[]          @default([])
  status                  ControlStatus     @default(DRAFT)
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@unique([providerId, cloudResourceType])
  @@map("generic_asset_templates")
}
