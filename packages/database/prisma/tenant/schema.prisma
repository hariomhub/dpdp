// ============================================
// TENANT SCHEMA
// Everything below lives in the tenant's own
// deployment. tenantId on every table enforces
// data isolation.
// ============================================

// ============================================
// ENUMS (Tenant specific)
// ============================================


generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  CEO
  CO
  IT_ADMIN
  INTERNAL_AUDITOR
  EXTERNAL_AUDITOR
}

enum UserStatus {
  ACTIVE
  PENDING_INVITE
  INACTIVE
}

// Why a user is INACTIVE. A directory sync only re-enables users it switched off itself; an administrator's
// decision is never overridden by it.
enum DeactivationReason {
  ADMIN
  ENTRA_SYNC
}

enum InviteSource {
  MANUAL
  ENTRA_ID
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum CloudConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DISCONNECTED
}

enum DraftStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  FILE
  SCREENSHOT
  CONFIG
  DOCUMENT
  LINK
  TEXT_NOTE
  LOG
}

enum EvidenceSource {
  MANUAL
  AUTOMATED
}

enum AssetCompliance {
  FULLY_COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_STARTED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetType {
  DATABASE_DATA_STORE
  SYSTEM_APPLICATION
  DATA_FLOW
  THIRD_PARTY_VENDOR
  CONSENT_MECHANISM
  PHYSICAL_HARDWARE
  API_INTEGRATION
  MOBILE_APPLICATION
  LEGACY_SYSTEM
  SAAS_THIRD_PARTY
  OUTSOURCED_MANAGED
  IN_HOUSE_CLOUD
  IN_HOUSE_ON_PREMISE
  THIRD_PARTY_CLOUD
}

enum Sensitivity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  VITAL_INTEREST
}

enum PrincipalType {
  CUSTOMER
  EMPLOYEE
  VENDOR
  MINOR
  OTHER
}

enum AssessmentStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  APPROVED_INTERNAL
  FINAL_REVIEW
  COMPLIANT
  REJECTED
  OVERDUE
}

enum ControlComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  EVIDENCE_REJECTED
  EVIDENCE_APPROVED
  TASK_OVERDUE
  TASK_ASSIGNED
  EVIDENCE_SUBMITTED
  FINAL_SIGNOFF
  ASSET_STATUS_CHANGED
  ASSESSMENT_DUE
  USER_INVITED
  ASSET_NON_COMPLIANT
}

enum TenantAuditAction {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  USER_INVITED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEPARTMENTS_UPDATED
  INVITATION_CANCELLED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  // Onboarding
  ONBOARDING_COMPLETED
  // Department
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  // Asset
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_DEACTIVATED
  // PII
  PII_RECORD_CREATED
  PII_RECORD_UPDATED
  PII_RECORD_DELETED
  // Supplier
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_DELETED
  // Assessment
  ASSESSMENT_CREATED
  ASSESSMENT_UPDATED
  ASSESSMENT_CLOSED
  // Task
  TASK_CREATED
  TASK_ASSIGNED
  TASK_STARTED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REJECTED
  TASK_ESCALATED
  TASK_REDELEGATED
  // Evidence
  EVIDENCE_UPLOADED
  EVIDENCE_UPDATED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  EVIDENCE_VIEWED
  EVIDENCE_DELETED
  // Gap findings
  GAP_FINDING_CREATED
  DISCOVERY_DRAFT_DISMISSED
  LMS_ENROLLED
  LMS_UNENROLLED
  INSTANCE_ACTIVATED
  LICENCE_INSTALLED
  ENTRA_SYNC_COMPLETED
  ENTRA_SYNC_REFUSED
  // Settings
  SETTINGS_UPDATED
  CLASSIFICATION_CHANGED
  ENTRA_CONNECTED
  ENTRA_DISCONNECTED
  ENTRA_GROUP_REMOVED
  ENTRA_RECONNECTED
  // Cloud Connections (Prowler scanning — separate from Entra)
  CLOUD_CONNECTION_CREATED
  CLOUD_CONNECTION_TESTED
  CLOUD_CONNECTION_FAILED
  CLOUD_CONNECTION_DISCONNECTED
  ASSETS_DISCOVERED
  // Compliance scanning — automated evidence/gap findings from Prowler
  AUTOMATED_EVIDENCE_CREATED
  AUTOMATED_GAP_FINDING_CREATED
}

// ============================================
// USERS
// ============================================

model User {
  id           String      @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String?     // null if Entra ID only
  role         TenantRole
  status       UserStatus  @default(PENDING_INVITE)
  source       InviteSource @default(MANUAL)
  entraObjectId String?    // Microsoft Entra ID object ID
  syncedGroupId String?    // EntraGroupMapping.id that sourced this user (non-FK, nullable)
  invitedById  String?     // FK to User who invited
  invitedBy    User?       @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees     User[]      @relation("InvitedBy")
  lastLoginAt  DateTime?
  // Set when the password is reset. Sessions (refresh tokens) issued before this moment are rejected, so a
  // password reset also ends any session an attacker may be holding.
  passwordChangedAt DateTime?
  deactivatedReason DeactivationReason?
  joinedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  passwordResetTokens  PasswordResetToken[]
  departments          DepartmentUser[]
  assignedTasks        ComplianceTask[]      @relation("AssignedTo")
  createdTasks         ComplianceTask[]      @relation("CreatedBy")
  reviewedTasks        ComplianceTask[]      @relation("ReviewedBy")
  uploadedEvidence     Evidence[]
  gapFindings          GapFinding[]
  notifications        Notification[]
  auditLogs            TenantAuditLog[]
  invitations          UserInvitation[]
  quizAttempts         QuizAttempt[]
  lessonProgress       LmsLessonProgress[]
  assignmentSubmissions LmsAssignmentSubmission[]
  issuedCertificates   IssuedCertificate[]

  lmsDesignation       String?     // references LmsDesignation.name (super admin schema)

  @@unique([tenantId, email])
  @@map("users")
}

// ============================================
// PASSWORD RESET TOKENS
// One row per reset link issued. Only a SHA-256 of the token is stored (the token itself exists only in the
// emailed link), each is single-use, and it expires after one hour.
// ============================================

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Refresh tokens that were signed out. Only a hash is stored; rows are removed once the token would have expired anyway.
model RevokedRefreshToken {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_refresh_tokens")
}

// Per-organisation counters for human-readable codes (AST-001, ACT-001). Allocated atomically in the database, so two
// concurrent requests can never be handed the same number.
model CodeCounter {
  tenantId String
  name     String
  value    Int

  @@id([tenantId, name])
  @@map("code_counters")
}

// ============================================
// THE ORGANISATION AND ITS LICENCE
// The record of who this deployment serves, and the signed licence that activates it. Both live in the customer's own
// database: nothing about the organisation is kept in the vendor's.
// ============================================

model TenantProfile {
  id             String    @id // the organisation id - the same value as `tenantId` on every other row
  tenantCode     String    @unique
  name           String
  industry       String    @default("")
  orgSize        String    @default("")
  address        String    @default("")
  country        String    @default("India")
  website        String?
  contactEmail   String
  dpoName        String    @default("")
  dpoEmail       String    @default("")
  dpoPhone       String?
  panNumber      String?
  gstNumber      String?
  classification String    @default("Data Fiduciary")
  classUncertain Boolean   @default(false)
  ceoName        String
  ceoEmail       String
  plan           String    @default("STARTER")
  status         String    @default("ONBOARDING") // ONBOARDING | ACTIVE (whether the portal may be used is the licence's business)

  // The first CEO is invited by the instance itself when it is activated
  inviteToken      String?   @unique
  inviteExpiresAt  DateTime?
  inviteAcceptedAt DateTime?

  onboardedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("tenant_profiles")
}

// Which applicability category (a Library id) the organisation holds under each regulation
model TenantRegulationClassification {
  id                      String   @id @default(uuid())
  tenantId                String
  regulationId            String
  applicabilityCategoryId String
  isUncertain             Boolean  @default(false)
  classifiedAt            DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tenantId, regulationId])
  @@map("tenant_regulation_classifications")
}

// The licence installed for the organisation, kept verbatim and re-verified on every start
model PlatformLicence {
  tenantId     String    @id
  licenceId    String
  token        String    // the signed licence exactly as issued
  keyId        String
  plan         String
  issuedAt     DateTime
  validFrom    DateTime
  validUntil   DateTime
  updatesUntil DateTime
  graceDays    Int
  airGapped    Boolean   @default(false)
  limits       Json
  entitlements Json
  activatedAt  DateTime  @default(now())
  // the latest time this instance has observed (monotonic) - a clock wound back to dodge expiry is noticed
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("platform_licences")
}

// ============================================
// CUSTOM CONTROLS (customer-authored; overlay kind ADD)
// Controls an organisation writes for itself. They live in the organisation's own database, never in the vendor's
// Library. Citations point at Library regulation nodes by id (a soft reference: the Library replica is replaceable).
// ============================================

model CustomControl {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String
  applicableTo String   @default("BOTH") // DATA_FIDUCIARY | SIGNIFICANT_DF | BOTH (free text, same vocabulary as the Library)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  citations CustomControlCitation[]
  actions   CustomControlAction[]

  @@index([tenantId])
  @@map("custom_controls")
}

model CustomControlCitation {
  id           String        @id @default(uuid())
  controlId    String
  control      CustomControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  regulationId String
  nodeId       String?       // Library regulation node (chapter / section / clause); null = the regulation as a whole

  @@index([controlId])
  @@map("custom_control_citations")
}

model CustomControlAction {
  id               String         @id @default(uuid())
  controlId        String
  control          CustomControl  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  title            String
  description      String
  evidenceTypes    EvidenceType[]
  suggestedDueDays Int            @default(30)
  priority         Priority       @default(HIGH)
  orderIndex       Int            @default(0)

  @@index([controlId])
  @@map("custom_control_actions")
}

// ============================================
// USER INVITATIONS
// Tracks pending invites with token and expiry
// ============================================

model UserInvitation {
  id          String     @id @default(uuid())
  tenantId    String
  email       String
  role        TenantRole
  token       String     @unique @default(uuid())
  note        String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById   String?
  invitedBy     User?      @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  departmentIds String[]   @default([])
  createdAt     DateTime   @default(now())

  @@map("user_invitations")
}

// ============================================
// DEPARTMENTS
// ============================================

model Department {
  id                   String    @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  ownerId              String?   // FK to User (department owner)

  // Auto-delegation mappings
  // When a task is created for an asset in this dept,
  // it auto-assigns to these users
  assignedItAdminId    String?   // FK to User with IT_ADMIN role
  assignedAuditorId    String?   // FK to User with INTERNAL_AUDITOR role

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  users                DepartmentUser[]
  assets               Asset[]
  suppliers            Supplier[]
  assessments          Assessment[]
  entraGroupMappings   EntraGroupMapping[]

  @@unique([tenantId, name])
  @@map("departments")
}

// Junction: User <-> Department (many-to-many)
// IT Admin and IA can belong to multiple departments
model DepartmentUser {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([userId, departmentId])
  @@map("department_users")
}

// ============================================
// ENTRA ID GROUP MAPPINGS
// Maps Entra ID groups to roles + departments
// ============================================

model EntraGroupMapping {
  id             String      @id @default(uuid())
  tenantId       String
  entraGroupId   String      // Entra ID group object ID
  entraGroupName String      // Display name
  role           TenantRole
  // departmentId null = org-wide role (CO, EA)
  // departmentId set = dept-specific role (IT Admin, IA)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, entraGroupId])
  @@map("entra_group_mappings")
}

// ============================================
// ASSETS (OWN ASSETS)
// ============================================

model Asset {
  id              String         @id @default(uuid())
  tenantId        String
  assetCode       String         // e.g., AST-001 (auto-generated)
  name            String
  assetType       AssetType
  description     String?
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId         String?
  status          AssetStatus    @default(ACTIVE)
  compliance      AssetCompliance @default(NOT_STARTED)
  criticality     Criticality    @default(MEDIUM)
  hostingLocation String
  internetFacing  Boolean        @default(false)
  vendorName      String?        // for vendor-hosted asset types
  dataCategories  String[]       // array of data category strings

  // Set once, when this asset is confirmed from a DiscoveredAssetDraft —
  // lets a later scan find the same real Asset again instead of only ever
  // producing new drafts. Soft reference (plain string, matches the
  // EntraConfig.connectedById convention) — not a hard FK, since an Asset
  // must keep meaning something even after its originating connection is
  // disconnected/deleted.
  cloudConnectionId String?
  cloudResourceUid  String?

  // Computed fields (updated by scoring engine)
  compliantControls Int          @default(0)
  totalControls     Int          @default(0)
  openTasks         Int          @default(0)
  riskScore         Float?

  registeredAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  piiRecords           PiiRecord[]
  assessmentAssets     AssessmentAsset[]
  complianceTasks      ComplianceTask[]
  assetRiskSnapshots   AssetRiskSnapshot[]

  @@unique([tenantId, assetCode])
  @@index([cloudConnectionId, cloudResourceUid])
  @@map("assets")
}

// ============================================
// PII RECORDS
// Separate table, linked to assets
// ============================================

model PiiRecord {
  id                    String       @id @default(uuid())
  tenantId              String
  assetId               String
  asset                 Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  categories            String[]     // array of PII category strings
  sensitivity           Sensitivity
  purpose               String
  legalBasis            LegalBasis
  retention             String
  deletionMechanism     String?
  volume                Int          // number of data principals
  crossBorderTransfer   Boolean      @default(false)
  crossBorderDest       String?      // required if crossBorderTransfer = true
  principalType         PrincipalType
  sharedWithThirdParties Boolean     @default(false)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("pii_records")
}

// ============================================
// SUPPLIERS
// ============================================

model Supplier {
  id                 String       @id @default(uuid())
  tenantId           String
  name               String
  supplierType       String       // Cloud Provider, Analytics, Payroll, etc.
  contactName        String?
  contactEmail       String
  countryOfOperation String       @default("India")
  dpaSigned          Boolean      @default(false)
  dpaReference       String?
  criticality        Criticality  @default(MEDIUM)
  status             AssetStatus  @default(ACTIVE)
  departmentId       String
  department         Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  supplierAssets     SupplierAsset[]

  @@map("suppliers")
}

// ============================================
// SUPPLIER ASSETS (VENDOR ASSETS)
// ============================================

model SupplierAsset {
  id              String      @id @default(uuid())
  tenantId        String
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  assetType       AssetType
  description     String?
  criticality     Criticality @default(MEDIUM)
  hostingLocation String?
  internetFacing  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  piiRecords      SupplierPiiRecord[]

  @@map("supplier_assets")
}

// ============================================
// SUPPLIER PII RECORDS
// ============================================

model SupplierPiiRecord {
  id                    String        @id @default(uuid())
  tenantId              String
  supplierAssetId       String
  supplierAsset         SupplierAsset @relation(fields: [supplierAssetId], references: [id], onDelete: Cascade)
  categories            String[]
  sensitivity           Sensitivity
  purpose               String
  legalBasis            LegalBasis
  retention             String
  deletionMechanism     String?
  volume                Int
  crossBorderTransfer   Boolean       @default(false)
  crossBorderDest       String?
  principalType         PrincipalType
  sharedWithThirdParties Boolean      @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("supplier_pii_records")
}

// ============================================
// ASSESSMENTS
// ============================================

model Assessment {
  id           String           @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  status       AssessmentStatus @default(ACTIVE)
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdById  String
  startDate    DateTime
  endDate      DateTime

  // Computed fields (updated by scoring engine)
  totalControls     Int          @default(0)
  compliantControls Int          @default(0)
  openTasks         Int          @default(0)

  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  assets           AssessmentAsset[]
  regulations      AssessmentRegulation[]
  controls         AssessmentControl[]
  complianceTasks  ComplianceTask[]

  @@map("assessments")
}

// Junction: Assessment <-> Asset (many-to-many)
model AssessmentAsset {
  assessmentId String
  assetId      String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  addedAt      DateTime   @default(now())

  @@id([assessmentId, assetId])
  @@map("assessment_assets")
}

// Junction: Assessment <-> Regulation (many-to-many)
model AssessmentRegulation {
  assessmentId String
  regulationId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([assessmentId, regulationId])
  @@map("assessment_regulations")
}

// Junction: Assessment <-> Control (many-to-many)
// Also tracks per-control compliance status within this assessment
// and records exclusion reasons if CO unchecked a control
model AssessmentControl {
  id             String                 @id @default(uuid())
  assessmentId   String
  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  controlId      String
  isExcluded     Boolean                @default(false)
  exclusionReason String?               // required if isExcluded = true
  complianceStatus ControlComplianceStatus @default(NOT_STARTED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([assessmentId, controlId])
  @@map("assessment_controls")
}

// ============================================
// COMPLIANCE TASKS
// Auto-created from control predefined actions
// when assessment is created
// ============================================

model ComplianceTask {
  id              String      @id @default(uuid())
  tenantId        String
  taskCode        String      // e.g., ACT-001 (auto-generated)
  title           String
  description     String
  instructions    String?     // CO instructions for IT Admin
  evidenceRequired String?    // what evidence is needed

  // Linkage (mandatory triad)
  assessmentId    String
  assessment      Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  controlId       String      // FK to Control (from super admin schema)
  assetId         String
  asset           Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Assignment
  assignedToId    String?
  assignedTo      User?       @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?       @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Review
  reviewedById    String?
  reviewedBy      User?       @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Status and priority
  status          TaskStatus  @default(PENDING)
  priority        Priority    @default(HIGH)
  dueDate         DateTime

  // Timestamps for state transitions
  startedAt       DateTime?   // when IT Admin clicked Start Working
  submittedAt     DateTime?   // when evidence submitted
  reviewedAt      DateTime?   // when IA reviewed
  approvedAt      DateTime?   // when IA approved
  signedOffAt     DateTime?   // when EA signed off
  rejectedAt      DateTime?

  // Auto-delegation info
  autoAssigned    Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  evidence        Evidence[]
  reviewNotes     TaskReviewNote[]
  statusHistory   TaskStatusHistory[]
  taskActions     TaskAction[]
  gapFindings     GapFinding[]

  @@unique([tenantId, taskCode])
  @@map("compliance_tasks")
}

// Per-task tracking anchor for a catalog ControlPredefinedAction.
// Created lazily on first evidence upload (or gap finding) for that action;
// an action with no TaskAction row is simply "not started" for this task.
model TaskAction {
  id                 String         @id @default(uuid())
  taskId             String
  task               ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  predefinedActionId String         // FK to ControlPredefinedAction (from super admin schema)
  createdAt          DateTime       @default(now())

  evidenceLinks      EvidenceAction[]
  gapFindingLinks    GapFindingAction[]

  @@unique([taskId, predefinedActionId])
  @@map("task_actions")
}

// Immutable status history log per task
model TaskStatusHistory {
  id          String     @id @default(uuid())
  taskId      String
  task        ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String?
  notes       String?
  createdAt   DateTime   @default(now())

  @@map("task_status_history")
}

// Review notes (IA feedback, CO decisions, EA notes)
model TaskReviewNote {
  id        String     @id @default(uuid())
  taskId    String
  task      ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  role      TenantRole
  note      String
  // CO decision type when handling rejections
  // redelegate | new_task | escalate | null
  decisionType String?
  createdAt DateTime   @default(now())

  @@map("task_review_notes")
}

// ============================================
// EVIDENCE
// ============================================

model Evidence {
  id           String       @id @default(uuid())
  tenantId     String
  taskId       String
  task         ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title        String
  type         EvidenceType
  description  String?

  // File storage
  // For FILE, SCREENSHOT, CONFIG, DOCUMENT, LOG:
  // fileUrl is LEGACY (pre-storage-adapter uploads, e.g. "/uploads/..."); new uploads set
  // storageProvider + storageKey instead and are only ever served through the authenticated
  // download route - a raw storage URL is never handed to the browser.
  fileUrl      String?
  fileName     String?
  fileSize     Int?         // bytes
  storageProvider String?   // 'azure' | 'local' - which store holds storageKey
  storageKey      String?   // tenantId/evidence/<taskId>/<uuid>.<ext>
  contentType     String?   // from the upload file policy, never from the client
  sha256          String?   // integrity: hash of the stored bytes

  // For LINK type
  linkUrl      String?

  // For TEXT_NOTE type
  textContent  String?

  submittedById String?
  submittedBy   User?       @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  // Automated evidence (source = AUTOMATED) has no submittedById — nothing
  // human submitted it. sourceCheckId traces it back to the Prowler check
  // that produced it.
  source        EvidenceSource @default(MANUAL)
  sourceCheckId String?

  // Review status
  reviewStatus  TaskStatus? // mirrors task status at time of review

  // Version tracking. Replacing a file or editing evidence snapshots the previous state into
  // EvidenceVersion and bumps `version`; nothing is overwritten or physically deleted.
  version      Int          @default(1)
  parentId     String?      // FK to previous version of this evidence
  isLatest     Boolean      @default(true)

  // Soft delete: evidence removed from the working view is kept (and its files with it).
  // Nothing is auto-purged; a retention policy, if any, is a separate decision.
  deletedAt    DateTime?
  deletedById  String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  versions     EvidenceVersion[]
  actionLinks  EvidenceAction[]

  @@index([taskId, deletedAt])
  @@map("evidence")
}

// Tags a single Evidence record to one or more TaskActions it satisfies,
// optionally naming which product (catalog or free-text "other") it demonstrates.
model EvidenceAction {
  id           String     @id @default(uuid())
  evidenceId   String
  evidence     Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  taskActionId String
  taskAction   TaskAction @relation(fields: [taskActionId], references: [id], onDelete: Cascade)
  productId    String?    // FK to Product (from super admin schema); null when otherLabel is set
  otherLabel   String?    // free-text tool name when not in the catalog
  createdAt    DateTime   @default(now())

  @@unique([evidenceId, taskActionId])
  @@map("evidence_actions")
}

// ============================================
// GAP FINDINGS
// Recorded by an Internal/External Auditor when rejecting a task: which
// action(s) failed, categorized reason(s), required remediation instructions,
// and supporting files documenting the gap. Immutable audit record.
// ============================================

enum GapReasonCode {
  INSUFFICIENT_EVIDENCE
  NON_COMPLIANT_CONFIGURATION
  MISSING_DOCUMENTATION
  INCORRECT_TOOL_USED
  OUTDATED_EVIDENCE
  OTHER
}

model GapFinding {
  id           String         @id @default(uuid())
  tenantId     String
  taskId       String
  task         ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raisedById   String?
  raisedBy     User?          @relation(fields: [raisedById], references: [id], onDelete: SetNull)
  // Nullable — an automated gap finding (source = AUTOMATED) has no human
  // raiser and therefore no role. A human-raised one (source = MANUAL,
  // the only kind before this field existed) always has one.
  role         TenantRole?
  reasonCodes  GapReasonCode[]
  otherReason  String?        // free text, relevant when OTHER is among reasonCodes
  remediation  String         // required: what should be done to fix this
  source        EvidenceSource @default(MANUAL)
  sourceCheckId String?
  createdAt    DateTime       @default(now())

  actionLinks  GapFindingAction[]
  files        GapFindingFile[]

  @@map("gap_findings")
}

// Tags a GapFinding to one or more TaskActions it applies to.
model GapFindingAction {
  id           String     @id @default(uuid())
  gapFindingId String
  gapFinding   GapFinding @relation(fields: [gapFindingId], references: [id], onDelete: Cascade)
  taskActionId String
  taskAction   TaskAction @relation(fields: [taskActionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([gapFindingId, taskActionId])
  @@map("gap_finding_actions")
}

model GapFindingFile {
  id           String     @id @default(uuid())
  gapFindingId String
  gapFinding   GapFinding @relation(fields: [gapFindingId], references: [id], onDelete: Cascade)
  fileUrl      String?    // LEGACY ("/uploads/..."); new uploads use storageProvider + storageKey
  fileName     String
  fileSize     Int
  storageProvider String?
  storageKey      String?
  contentType     String?
  sha256          String?
  createdAt    DateTime   @default(now())

  @@map("gap_finding_files")
}

// Immutable version history for evidence
// Every time evidence is updated a new version record is created
model EvidenceVersion {
  id           String    @id @default(uuid())
  evidenceId   String
  evidence     Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  version      Int
  // Snapshot of the evidence as it was BEFORE it was changed (or the file replaced).
  title        String?
  description  String?
  fileUrl      String?   // LEGACY
  fileName     String?
  fileSize     Int?
  storageProvider String?
  storageKey      String?
  contentType     String?
  sha256          String?
  linkUrl      String?
  textContent  String?
  uploadedById String?   // who submitted that version
  uploadedAt   DateTime  @default(now())  // when that version was created
  supersededAt DateTime  @default(now())  // when it was replaced
  supersededById String? // who replaced it

  @@index([evidenceId, version])
  @@map("evidence_versions")
}

// ============================================
// RISK SNAPSHOTS
// Daily computed risk scores for trend charts
// ============================================

model RiskSnapshot {
  id           String   @id @default(uuid())
  tenantId     String
  snapshotDate DateTime @db.Date
  entityType   String   // "org" | "department" | "asset" | "regulation"
  entityId     String   // ID of the org/dept/asset/regulation
  entityName   String
  riskScore    Float    // 0-100
  riskLevel    String   // Low | Moderate | High | Critical | Severe

  // Contributing factors stored as JSON
  // { nonCompliantControls, overdueTasks, piiSensitivity,
  //   assetCriticality, regulationWeight }
  factors      Json?

  createdAt    DateTime @default(now())

  // One snapshot per entity per day
  @@unique([tenantId, entityType, entityId, snapshotDate])
  @@map("risk_snapshots")
}

// Asset-level risk (separate for efficient querying)
model AssetRiskSnapshot {
  id           String   @id @default(uuid())
  tenantId     String
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date
  riskScore    Float
  riskLevel    String
  factors      Json?
  createdAt    DateTime @default(now())

  @@unique([tenantId, assetId, snapshotDate])
  @@map("asset_risk_snapshots")
}

// ============================================
// DASHBOARD METRIC SNAPSHOTS
// Daily org-wide compliance/operational metrics for trend charts.
// Companion to RiskSnapshot (risk has its own table/shape already);
// this covers everything else the dashboard computes that has no
// history today (compliance score, overdue breakdown, etc).
// ============================================

model DashboardMetricSnapshot {
  id                  String   @id @default(uuid())
  tenantId            String
  snapshotDate        DateTime @db.Date

  complianceScore     Int?     // null if no active assessments that day
  totalControls       Int      @default(0)
  compliantControls   Int      @default(0)

  overdueTasksTotal   Int      @default(0)
  overdueCritical     Int      @default(0)
  overdueHigh         Int      @default(0)
  overdueMedium       Int      @default(0)
  overdueLow          Int      @default(0)

  crossBorderPiiCount Int      @default(0)
  suppliersWithoutDpa Int      @default(0)
  auditReadinessScore Int?

  createdAt           DateTime @default(now())

  // One snapshot per tenant per day
  @@unique([tenantId, snapshotDate])
  @@map("dashboard_metric_snapshots")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String               @id @default(uuid())
  tenantId   String
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  priority   NotificationPriority @default(MEDIUM)
  title      String
  body       String
  // Link to the relevant record
  linkType   String?              // "task" | "asset" | "assessment" | "evidence"
  linkId     String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@map("notifications")
}

// ============================================
// TENANT AUDIT LOG
// Immutable. No updates, no deletes ever.
// ============================================

model TenantAuditLog {
  id         String            @id @default(uuid())
  tenantId   String
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       TenantRole?
  action     TenantAuditAction
  targetType String
  targetId   String?
  targetName String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime          @default(now())

  @@map("tenant_audit_logs")
}

// ============================================
// LMS ENROLLMENTS
// Tracks which users are enrolled in courses
// ============================================

model LmsEnrollment {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  courseId    String    // FK to LmsCourse (super admin schema)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  isCompleted Boolean   @default(false)

  // Relations
  lessonProgress LmsLessonProgress[]
  quizAttempts   QuizAttempt[]
  assignmentSubmissions LmsAssignmentSubmission[]

  @@unique([tenantId, userId, courseId])
  @@map("lms_enrollments")
}

// ============================================
// LMS LESSON PROGRESS
// Tracks progress per lesson per user
// ============================================

model LmsLessonProgress {
  id           String        @id @default(uuid())
  tenantId     String
  enrollmentId String
  enrollment   LmsEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String        // FK to LmsLesson (super admin schema)
  isCompleted  Boolean       @default(false)
  completedAt  DateTime?
  // For video lessons
  watchedSeconds Int?

  @@unique([enrollmentId, lessonId])
  @@map("lms_lesson_progress")
}

// ============================================
// LMS ASSIGNMENT SUBMISSIONS
// A learner's submission for an ASSIGNMENT-type lesson
// ============================================

model LmsAssignmentSubmission {
  id           String        @id @default(uuid())
  tenantId     String
  enrollmentId String
  enrollment   LmsEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String        // FK to LmsLesson (super admin schema)
  textAnswer   String?
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  submittedAt  DateTime      @default(now())

  @@unique([enrollmentId, lessonId])
  @@map("lms_assignment_submissions")
}

// ============================================
// QUIZ ATTEMPTS
// ============================================

model QuizAttempt {
  id           String        @id @default(uuid())
  tenantId     String
  enrollmentId String
  enrollment   LmsEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId       String        // FK to LmsQuiz (super admin schema)
  attemptNumber Int
  score        Float         // percentage e.g., 85.5
  totalMarks   Int
  earnedMarks  Int
  passed       Boolean
  timeTakenS   Int?          // time taken in seconds
  startedAt    DateTime      @default(now())
  completedAt  DateTime?

  // Relations
  answers      QuizAttemptAnswer[]

  @@map("quiz_attempts")
}

// ============================================
// QUIZ ATTEMPT ANSWERS
// Individual question answers per attempt
// ============================================

model QuizAttemptAnswer {
  id            String      @id @default(uuid())
  attemptId     String
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String      // FK to QuizQuestion (super admin schema)
  // MCQ: selected option ID
  selectedOptionId String?
  // True-False: true or false
  tfAnswer      Boolean?
  // Descriptive: text response
  textAnswer    String?
  isCorrect     Boolean?    // null for descriptive (manual grading)
  marksAwarded  Float?
  createdAt     DateTime    @default(now())

  @@map("quiz_attempt_answers")
}

// ============================================
// ISSUED CERTIFICATES
// ============================================

model IssuedCertificate {
  id                  String    @id @default(uuid())
  tenantId            String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId            String    // FK to LmsCourse (super admin schema)
  certificateTemplateId String? // FK to CertificateTemplate (super admin schema)
  certificateCode     String    @unique // e.g., CERT-2025-001
  issuedAt            DateTime  @default(now())
  isRevoked           Boolean   @default(false)
  revokedAt           DateTime?
  revocationReason    String?
  // PDF stored in Azure Blob Storage
  pdfUrl              String?

  @@map("issued_certificates")
}
// ============================================
// ENTRA ID CONFIGURATION
// Stores credentials for Microsoft Entra ID
// integration — encrypted at rest.
// One record per tenant (unique on tenantId).
// ============================================

model EntraConfig {
  id                    String    @id @default(uuid())
  tenantId              String    @unique
  tenantDomain          String    // e.g., "yourorg.onmicrosoft.com"
  clientId              String    // Azure App Registration Client ID (GUID)
  clientSecretEncrypted String    // AES-256-GCM encrypted client secret
  azureTenantId         String    // Azure AD Tenant ID (GUID)
  isConnected           Boolean   @default(true)
  connectedById         String?   // FK to User who set up the integration
  lastSyncAt            DateTime?
  // Lease held while a directory sync runs, so two syncs (two clicks, two replicas) cannot overlap. A lease older than
  // the allowed run time is considered abandoned (the process died) and can be taken over.
  syncStartedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("entra_configs")
}


// ============================================
// ROLE DESIGNATION DEFAULTS
// CO configures once: "All IT_ADMIN → CISO by default"
// Applied when users are created/synced.
// Individual override always possible.
// ============================================

model RoleDesignationDefault {
  id          String     @id @default(uuid())
  tenantId    String
  portalRole  TenantRole
  designation String     // e.g. "CISO" — references LmsDesignation.name
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, portalRole])
  @@map("role_designation_defaults")
}

// ============================================
// TENANT CLOUD CONNECTIONS
// Credentials for scanning a tenant's cloud/SaaS accounts
// via Prowler. Encrypted at rest using the same AES-256-GCM
// utility as EntraConfig. Deliberately separate from
// EntraConfig — Entra is for login/SSO only; this is for
// infrastructure scanning, and a tenant may have many of
// these at once (one per provider connection), unlike the
// single-row-per-tenant EntraConfig.
// ============================================

model TenantCloudConnection {
  id                  String                @id @default(uuid())
  tenantId            String
  providerKey         String                // matches CloudProviderType.key (super admin schema)
  alias               String                // user-given label, e.g. "Production Azure Subscription"
  credentialEncrypted String                // AES-256-GCM ciphertext of the JSON credential payload
  status              CloudConnectionStatus @default(PENDING)
  lastCheckedAt       DateTime?
  lastError           String?
  connectedById       String?               // FK to User who set up the connection (soft reference, matches EntraConfig convention)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([tenantId, providerKey, alias])
  @@map("tenant_cloud_connections")

  discoveredAssets DiscoveredAssetDraft[]
}

// ============================================
// DISCOVERED ASSET DRAFTS
// A discovery scan's raw output, staged here for human review before it
// becomes a real Asset — matches the design principle that automated
// discovery only ever produces suggestions, never writes Asset/PII records
// directly. suggestedAssetType/suggestedCriticality come from matching the
// resource's cloudResourceType against the super-admin Generic Asset
// Catalog; null means no matching template exists yet (shown to the
// reviewer as "Unrecognized resource" rather than silently dropped).
// ============================================

model DiscoveredAssetDraft {
  id                   String                 @id @default(uuid())
  tenantId             String
  connectionId         String
  connection           TenantCloudConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  cloudResourceUid     String                 // Prowler's resource uid (ARN, resource ID, ...)
  name                 String
  region               String
  service              String
  cloudResourceType    String

  suggestedAssetType   String?                // matched AssetType enum value, null if unrecognized
  suggestedCriticality String?
  // Best-effort only: not yet derived from findings (e.g. Prowler's
  // "internet-exposed" check category) — defaults false until that
  // wiring is added. Flagged here rather than silently assumed correct.
  internetFacing       Boolean                @default(false)

  tags                 Json?
  metadata             Json?

  status               DraftStatus            @default(PENDING)
  reviewedAssetId      String?                // set once confirmed into a real Asset
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([connectionId, cloudResourceUid])
  @@map("discovered_asset_drafts")
}
