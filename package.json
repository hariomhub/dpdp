{
  "name": "dpdp-cms",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n turbo,scanner -c blue,magenta \"turbo dev\" \"node scripts/dev-scanner.js\"",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "test": "vitest run",
    "azurite": "azurite --silent --location .azurite --skipApiVersionCheck",
    "test:db": "node scripts/test-db.js"
  },
  "devDependencies": {
    "azurite": "^3.35.0",
    "concurrently": "^9.1.0",
    "turbo": "^2.9.7",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react-hot-toast": "^2.6.0"
  }
}
